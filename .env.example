# Production domain / Canonical base URL for SEO, sitemap.xml, robots.txt, and Open Graph
NEXT_PUBLIC_SITE_URL=https://dxwconstruction.com

# Resend API configuration for transactional contact form emails (server-side only)
# Sign up at https://resend.com and generate an API key with sending permissions
RESEND_API_KEY=re_your_api_key_here
CONTACT_TO_EMAIL=contact@dxwconstruction.com
CONTACT_FROM_EMAIL="DXW Website <website@forms.dxwconstruction.com>"
